//| mill-version: 1.1.8
package build

import mill.*
import mill.scalalib.*
import mill.scalalib.publish.*

import scalago.mill.ScalaGoModule as UserScalaGoModule
import scalago.mill.TastyIR

object Versions {
  /** The plugin hooks compiler internals, so it is built against one exact compiler version.
   *  User code compiled with the plugin must use this same Scala version.
   */
  val scala = UserScalaGoModule.ScalaVersion
  /** Mill's own Scala version: the Mill plugin is compiled with it. */
  val millScala = "3.8.2"
  val mill = "1.1.8"
  val munit = "1.3.0"
  val gears = "0.3.1"
}

trait ScalaGoModule extends ScalaModule {
  def scalaVersion = Versions.scala
  def scalacOptions = Seq("-deprecation", "-feature", "-Wunused:all")
}

trait Published extends PublishModule {
  def publishVersion = UserScalaGoModule.Version
  def pomSettings = PomSettings(
    description = "scala-go: compile Scala 3 to Go",
    organization = UserScalaGoModule.Organization,
    url = "https://github.com/scalago/scala-go",
    licenses = Seq(License.`Apache-2.0`),
    versionControl = VersionControl(),
    developers = Seq()
  )
}

/** Compiles a module of this build with the plugin (the plugin jar is not on the classpath). */
trait WithPlugin extends ScalaGoModule {
  def pluginOptions: T[Seq[String]] = Task {
    Seq(s"-Xplugin:${plugin.jar().path}", s"-P:scala-go:plugin-signature:${plugin.jar().sig}")
  }
}

/** The IR shared between the compiler plugin (writer) and the linker (reader). No dependencies. */
object ir extends ScalaGoModule with Published {
  def artifactName = "scalago-ir"
}

/** Scala 3 compiler plugin: runs after the JVM lowering phases and emits `.goir` files next to `.class` files. */
object plugin extends ScalaGoModule with Published {
  def artifactName = "scalago-plugin"
  // Tied to one compiler version: published with the full Scala version as suffix.
  def artifactSuffix = s"_${scalaVersion()}"
  // The IR classes are compiled into the plugin jar, so that `-Xplugin:<jar>` is self-contained.
  def sources = Task.Sources(moduleDir / "src", moduleDir / os.up / "ir" / "src")
  def compileMvnDeps = Seq(mvn"org.scala-lang::scala3-compiler:${Versions.scala}")

  /** Value for `-Xplugin:`. */
  def pluginClasspath = Task { jar().path.toString }
}

/** Java standard library classes (and replacements for the Java classes of the Scala library),
 *  written in Scala and compiled with the plugin. Only their `.goir` files are used: the `.class`
 *  files must never be put on a JVM classpath.
 */
object javalib extends WithPlugin with Published {
  def artifactName = "scalago-javalib"

  /** javalib reimplements the JDK, whose API is documented by the JDK (scaladoc also cannot
   *  document sources that redefine JDK packages): an empty documentation jar, which Maven
   *  Central requires.
   */
  def docJar = Task {
    val jar = Task.dest / "out.jar"
    val out = new java.util.jar.JarOutputStream(java.nio.file.Files.newOutputStream(jar.toNIO), new java.util.jar.Manifest())
    out.close()
    PathRef(jar)
  }
  // Packages other than java.lang are compiled under their own names (java.util, ...). The Scala
  // compiler does not allow redefining core java.lang classes, so those live in scalago.javalib.lang
  // (and the Scala library's overrides in scalago.scalalib); the plugin emits them as java.lang /
  // scala.* in the IR. Static methods of JDK classes are methods of Scala objects, called through
  // static forwarders.
  def scalacOptions = Task {
    Seq("-feature", "-P:scala-go:rename:scalago.javalib.hijacked.lang:java.lang", "-P:scala-go:rename:scalago.javalib:java", "-P:scala-go:rename:scalago.scalalib:scala",
      "-P:scala-go:static-forwarders") ++ pluginOptions()
  }
  // Always compile all sources together: when compiling only some, the others' classes from the
  // previous run lose against the JDK's classes of the same names.
  def zincIncrementalCompilation = false

  def bufferTemplates = Task.Source(moduleDir / "templates")

  /** scala.runtime.function.JProcedure0..22: Java interfaces in the Scala library; and the
   *  java.nio buffers of each element type but bytes, from `templates/` (`CharBuffer` itself is
   *  written by hand, but its implementations are generated).
   */
  def generatedSources = Task {
    val templates = bufferTemplates().path
    val typed = os.read(templates / "TypedBuffer.scala.template")
    val impls = os.read(templates / "BufferImpls.scala.template")
    def floating(box: String) = Seq(
      "$same$" -> s"x == y || (java.lang.$box.isNaN(x) && java.lang.$box.isNaN(y))",
      "$compare$" -> s"if x < y then -1 else if x > y then 1 else if x == y then 0 else if java.lang.$box.isNaN(x) then (if java.lang.$box.isNaN(y) then 0 else 1) else -1"
    )
    def integral(box: String) = Seq("$same$" -> "x == y", "$compare$" -> s"java.lang.$box.compare(x, y)")
    val types = Seq(
      ("Char", 2, integral("Character")),
      ("Short", 2, integral("Short")),
      ("Int", 4, integral("Integer")),
      ("Long", 8, integral("Long")),
      ("Float", 4, floating("Float")),
      ("Double", 8, floating("Double"))
    )
    for ((t, size, ops) <- types) {
      def expand(template: String) =
        (Seq("$T$" -> t, "$B$" -> s"${t}Buffer", "$Size$" -> size.toString) ++ ops)
          .foldLeft(template) { case (s, (k, v)) => s.replace(k, v) }
      if (t != "Char") os.write(Task.dest / s"${t}Buffer.scala", expand(typed))
      os.write(Task.dest / s"${t}BufferImpls.scala", expand(impls))
    }

    val sb = new StringBuilder("package scalago.scalalib.runtime.function\n\n")
    for (n <- 0 to 22) {
      val tparams = (1 to n).map(i => s"T$i")
      val params = (1 to n).map(i => s"t$i: T$i").mkString(", ")
      val args = (1 to n).map(i => s"t$i").mkString(", ")
      val tps = if (n == 0) "" else tparams.mkString("[", ", ", "]")
      val fn = s"scala.Function$n[${(tparams :+ "scala.runtime.BoxedUnit").mkString(", ")}]"
      sb ++= s"trait JProcedure$n$tps extends $fn with java.io.Serializable:\n"
      sb ++= s"  def applyVoid($params): Unit\n"
      sb ++= s"  override def apply($params): scala.runtime.BoxedUnit =\n"
      sb ++= s"    applyVoid($args)\n"
      sb ++= s"    scala.runtime.BoxedUnit.UNIT\n\n"
    }
    os.write(Task.dest / "JProcedures.scala", sb.toString)
    Seq(PathRef(Task.dest))
  }
}

/** User-facing scala-go APIs (e.g. `scalago.go.GoString`). A normal Scala library, compiled with
 *  the plugin so that its IR ships in the same jar.
 */
object library extends WithPlugin with Published {
  def artifactName = "scalago-library"
  def scalacOptions = Task { super.scalacOptions() ++ pluginOptions() }
}

/** IR for the Scala standard library, compiled from the TASTy files it ships (Scala 3.8+). */
object stdlib extends ScalaGoModule with Published {
  def artifactName = "scalago-scalalib-ir"
  def artifactSuffix = s"_${scalaVersion()}"
  /** The published jar contains only the `.goir` files. */
  def resources = Task { Seq(ir()) }

  def libraryJar = Task {
    defaultResolver()
      .classpath(Seq(mvn"org.scala-lang:scala-library:${Versions.scala}"))
      .find(_.path.last.startsWith("scala-library"))
      .get
  }

  def compilerClasspath = Task {
    defaultResolver().classpath(Seq(mvn"org.scala-lang::scala3-compiler:${Versions.scala}"))
  }

  /** Directory of `.goir` files (see `TastyIR`). `scala.quoted` (macros only) is skipped: the
   *  compiler cannot recompile it from TASTy.
   */
  def ir = Task {
    val out = Task.dest / "ir"
    TastyIR.compile(libraryJar().path, Nil, out, Task.dest / "work", compilerClasspath().map(_.path), plugin.jar().path,
      skip = _.segments.contains("quoted"))
    PathRef(out)
  }
}

/** gears (lampepfl/gears) on goroutines. gears itself is compiled from its TASTy (`gearsIR`); this
 *  module overrides the one class that needs JVM-only APIs (`VThreadScheduler`, which uses
 *  `Thread.ofVirtual` and a `VarHandle`): its sources in `scalago.gearsrt` are emitted as
 *  `gears.async` in the IR, and come first on the link classpath. It also has helpers to use Go
 *  channels and contexts from gears (`scalago.gears`).
 */
object gears extends WithPlugin with Published {
  def artifactName = "scalago-gears"
  def gearsDep = mvn"ch.epfl.lamp::gears:${Versions.gears}"
  def mvnDeps = Seq(gearsDep)
  def moduleDeps = Seq(library)
  def scalacOptions = Task { super.scalacOptions() ++ pluginOptions() ++ Seq("-P:scala-go:rename:scalago.gearsrt:gears.async") }

  def gearsJar = Task {
    defaultResolver().classpath(Seq(gearsDep)).find(_.path.last.startsWith("gears_3")).get
  }

  /** gears' IR, compiled from its TASTy (for the tests; ScalaGoModule does this for users). */
  def gearsIR = Task {
    val out = Task.dest / "ir"
    TastyIR.compile(gearsJar().path, Seq(stdlib.libraryJar().path), out, Task.dest / "work",
      stdlib.compilerClasspath().map(_.path), plugin.jar().path)
    PathRef(out)
  }
}

/** Facades of the most-used Go standard library packages (`scalago.gostd`), generated from the
 *  packages' APIs by FacadeGen, with the types of other packages that they use.
 */
object gostd extends WithPlugin with Published {
  def artifactName = "scalago-gostd"
  def moduleDeps = Seq(library)
  // Generated code: unused-parameter warnings would be noise.
  def scalacOptions = Task { Seq("-deprecation", "-feature") ++ pluginOptions() }

  def goPackages = Seq(
    "bufio", "bytes", "context", "encoding/base64", "encoding/hex", "encoding/json", "errors", "fmt", "io",
    "math", "net/url", "os", "path", "path/filepath", "sort", "strconv", "strings", "sync", "time",
    "unicode", "unicode/utf8"
  )

  def generatedSources = Task {
    os.proc(
      "java", "-cp", linker.runClasspath().map(_.path).mkString(java.io.File.pathSeparator),
      "scalago.linker.FacadeGen", "--out", Task.dest, "--package", "scalago.gostd", goPackages
    ).call(stdout = os.Pipe)
    Seq(PathRef(Task.dest))
  }
}

/** Whole-program linker: reads `.goir` files from a classpath and emits a Go module. */
object linker extends ScalaGoModule with Published {
  def artifactName = "scalago-linker"
  def moduleDeps = Seq(ir)

  def goRuntimeDir = Task.Source(moduleDir / os.up / "runtime" / "rt")

  /** Bundles the Go runtime sources as resources under `scalago/rt/`, plus an index file. */
  def goRuntimeResources = Task {
    val dest = Task.dest / "scalago" / "rt"
    os.makeDir.all(dest)
    val files = os.list(goRuntimeDir().path)
      .filter(p => (p.ext == "go" || p.ext == "s") && !p.last.endsWith("_test.go"))
      .sortBy(_.last)
    files.foreach(f => os.copy.into(f, dest))
    os.write(dest / "files.txt", files.map(_.last).mkString("", "\n", "\n"))
    // The goapi helper, which the linker runs to read the APIs of Go packages.
    os.copy(goApiHelper().path, Task.dest / "scalago" / "goapi" / "main.go", createFolders = true)
    PathRef(Task.dest)
  }

  def goApiHelper = Task.Source(moduleDir / os.up / "runtime" / "goapi" / "main.go")

  def resources = Task { super.resources() :+ goRuntimeResources() }

  object test extends ScalaTests with TestModule.Munit {
    def mvnDeps = Seq(
      mvn"org.scalameta::munit:${Versions.munit}",
      mvn"org.scala-lang::scala3-compiler:${Versions.scala}"
    )
    def testCasesDir = Task.Source(moduleDir / os.up / os.up / "tests" / "cases")
    def forkEnv = Task {
      super.forkEnv() ++ Map(
        "SCALAGO_PLUGIN_CP" -> plugin.pluginClasspath(),
        "SCALAGO_LIBRARY_IR" -> Seq(javalib.compile().classes.path, stdlib.ir().path).mkString(java.io.File.pathSeparator),
        "SCALAGO_USER_LIBRARY" -> library.compile().classes.path.toString,
        // gears: its jar (to compile and run test programs on the JVM), and its IR with the
        // scala-go override first.
        // The generated standard-library facades too (their IR is in their classes directory).
        "SCALAGO_EXTRA_CP" -> Seq(gears.compile().classes.path, gears.gearsJar().path, gostd.compile().classes.path)
          .mkString(java.io.File.pathSeparator),
        "SCALAGO_EXTRA_IR" -> Seq(gears.compile().classes.path, gostd.compile().classes.path, gears.gearsIR().path)
          .mkString(java.io.File.pathSeparator),
        "SCALAGO_TEST_CASES" -> testCasesDir().path.toString
      )
    }
  }
}

/** The Mill plugin (`scalago.mill.ScalaGoModule`). Its source is in `mill-build/src`, where this
 *  build also uses it directly (see `examples`).
 */
object millplugin extends ScalaModule with Published {
  def scalaVersion = Versions.millScala
  def artifactName = "mill-scalago"
  def artifactSuffix = "_mill1_3"
  def sources = Task.Sources(moduleDir / os.up / "mill-build" / "src")
  def compileMvnDeps = Seq(mvn"com.lihaoyi::mill-libs:${Versions.mill}")
}

/** A ScalaGoModule that uses this build's modules instead of published artifacts. */
trait InBuildScalaGoModule extends UserScalaGoModule {
  def scalaGoPlugin = plugin.jar()
  def scalaGoLinkerClasspath = linker.runClasspath()
  def scalaGoLibraryIR = Task { Seq(javalib.compile().classes, stdlib.ir()) }
  def scalaGoLibraryDeps = Task { Seq.empty[Dep] }
  def moduleDeps: Seq[JavaModule] = Seq(library)
}

/** CPU benchmarks of generated code against the JVM: `mill bench.run [rounds]` on the JVM,
 *  `mill bench.goRun [rounds]` as Go. Later rounds show warmed-up JVM performance.
 */
object bench extends InBuildScalaGoModule

/** Example programs, each built with ScalaGoModule (`examples/<name>`). Those with a `check`
 *  command verify themselves: `mill examples.__.check`.
 */
object examples extends Module {
  /** A program built with ScalaGoModule: `mill examples.basics.goRun [names...]`. */
  object basics extends InBuildScalaGoModule {
    override def moduleDeps = Seq(library, gears)
    // gears comes as a plain Scala dependency: ScalaGoModule compiles it from TASTy.
    def mvnDeps = Seq(gears.gearsDep)
    def goLocalModules = Task.Sources(moduleDir / "go" / "textstats")
    // Facades generated from Go packages: a standard library package, and the local module.
    def goFacadePackages = Seq("strconv", "example.com/textstats")
  }

  /** Popular Scala 3 libraries, compiled from TASTy like any dependency (none has a scala-go
   *  specific artifact): `mill examples.ecosystem.check` runs the program on the JVM and as Go and checks
   *  that both print the same.
   */
  object ecosystem extends InBuildScalaGoModule {
    def mvnDeps = Seq(
      mvn"org.typelevel::cats-core:2.13.0",
      mvn"com.lihaoyi::upickle:4.4.1",
      mvn"com.lihaoyi::fastparse:3.1.1",
      mvn"com.lihaoyi::pprint:0.9.4",
      mvn"com.lihaoyi::mainargs:0.7.6",
      mvn"com.lihaoyi::os-lib:0.11.4"
    )

    def check() = Task.Command {
      val javaExe = os.Path(sys.props("java.home")) / "bin" / "java"
      val classpath = runClasspath().map(_.path).filter(os.exists(_)).mkString(java.io.File.pathSeparator)
      val jvm = os.proc(javaExe, "-cp", classpath, finalMainClass()).call().out.text()
      val go = os.proc(goBuild().path).call().out.text()
      if (jvm != go) throw new Exception(s"the JVM and Go outputs differ:\n--- JVM\n$jvm--- Go\n$go")
      println(s"JVM and Go outputs agree (${jvm.linesIterator.size} lines)")
    }
  }

  /** Popular Go libraries used from Scala through generated facades: a bubbletea TUI styled with
   *  lipgloss, using bubbles components. `mill examples.gotui.goRun` runs it in the terminal; `mill examples.gotui.check`
   *  runs it on scripted keys and checks the final state. The generated facades use those of
   *  scalago-gostd for the standard library's types (`io.Reader`, `time.Duration`).
   */
  object gotui extends InBuildScalaGoModule {
    override def moduleDeps = Seq(library, gostd)
    def goRequires = Seq(
      "github.com/charmbracelet/bubbletea@v1.3.10",
      "github.com/charmbracelet/lipgloss@v1.1.0",
      "github.com/charmbracelet/bubbles@v1.0.0"
    )
    def goFacadePackages = Seq(
      "github.com/charmbracelet/bubbletea",
      "github.com/charmbracelet/lipgloss",
      "github.com/charmbracelet/bubbles/textinput",
      "github.com/charmbracelet/bubbles/spinner",
      "github.com/charmbracelet/bubbles/key"
    )

    def check() = Task.Command {
      val expected = Seq("2 todos, 1 done, saved 3 times", "[ ] buy milk", "[x] walk the dog").mkString("", "\n", "\n")
      val output = os.proc(goBuild().path, "--demo").call().out.text()
      if (output != expected) throw new Exception(s"unexpected output:\n$output")
      println("bubbletea demo: the final state is as expected")
    }
  }

  /** An HTTP JSON API on gin. `mill examples.gin.goRun` serves it on :8080; `mill examples.gin.check`
   *  runs it with `--self-test`: it serves on a free port, sends itself requests and checks the
   *  responses.
   */
  object gin extends InBuildScalaGoModule {
    override def moduleDeps = Seq(library, gostd)
    def goRequires = Seq("github.com/gin-gonic/gin@v1.12.0")
    def goFacadePackages = Seq("net", "net/http", "github.com/gin-gonic/gin")

    def check() = Task.Command {
      val output = os.proc(goBuild().path, "--self-test").call().out.text()
      print(output)
      if (!output.linesIterator.contains("all requests answered as expected")) throw new Exception("the self-test failed")
    }
  }

  /** Configuration that reloads itself, on argus. `mill examples.argus.goRun <file>` watches a
   *  file; `mill examples.argus.check` runs it with `--self-test`: it edits a temporary file and
   *  checks that each change is seen.
   */
  object argus extends InBuildScalaGoModule {
    override def moduleDeps = Seq(library, gostd)
    def goRequires = Seq("github.com/agilira/argus@v1.7.5")
    def goFacadePackages = Seq("github.com/agilira/argus")

    def check() = Task.Command {
      val output = os.proc(goBuild().path, "--self-test").call().out.text()
      print(output)
      if (!output.linesIterator.contains("all changes seen as expected")) throw new Exception("the self-test failed")
    }
  }
}
